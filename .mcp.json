{
  "mcpServers": {
    "dlt-workspace-mcp": {
      "command": "uv",
      "args": [
        "run",
        "dlt",
        "ai",
        "mcp",
        "--stdio"
      ]
    },
    "dbt": {
      "command": "uvx",
      "args": [
        "dbt-mcp"
      ],
      "env": {
        "DBT_PROJECT_DIR": "/workspaces/txwc/omop",
        "DBT_PATH": "/workspaces/txwc/.venv/bin/dbt"
      }
    }
  }
}
